FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY trading/ ./trading/

WORKDIR /app/trading

ENV DBT_PROFILES_DIR=/app/trading
ENV DBT_TARGET=prod
ENV DBT_TRINO_HOST=trino
ENV DBT_TRINO_PORT=8080
ENV DBT_TRINO_USER=trino
ENV DBT_TRINO_DATABASE=iceberg
ENV DBT_TRINO_SCHEMA=raw_vault
ENV DBT_THREADS=1

CMD ["dbt", "run", "--profiles-dir", "/app/trading"]
